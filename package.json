{
  "name": "commerce",
  "private": true,
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:docs": "bun run --cwd apps/docs dev",
    "build": "turbo run build",
    "build:docs": "turbo run build --filter=@commerce/docs",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "lint": "biome check --error-on-warnings . && bun run lint:components",
    "lint:fix": "biome check --write .",
    "lint:components": "bun scripts/check-components.ts",
    "typecheck": "turbo run typecheck",
    "test:sweeps": "vitest run --config scripts/sweeps/vitest.config.ts",
    "db:generate": "bun run --cwd packages/db generate",
    "db:migrate": "bun run --cwd packages/db migrate",
    "db:seed": "bun run --cwd packages/db seed",
    "db:seed:demo": "bun run --cwd packages/db seed:demo",
    "db:seed:demo:collections": "bun run --cwd packages/db seed:demo:collections",
    "db:seed:navigation": "bun run --cwd packages/db seed:navigation",
    "db:seed:shipping": "bun run --cwd packages/db seed:shipping",
    "db:seed:back-in-stock": "bun run --cwd packages/db seed:back-in-stock",
    "rotate-secrets": "bun scripts/rotate-secrets.ts",
    "backfill-phone-encryption": "bun scripts/backfill-phone-encryption.ts",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1137.0",
    "@biomejs/biome": "2.5.14",
    "turbo": "^2.11.2",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@commerce/backup": "workspace:*",
    "@commerce/blocks": "workspace:*",
    "@commerce/config": "workspace:*",
    "@commerce/core": "workspace:*",
    "@commerce/db": "workspace:*",
    "@commerce/notifications-ses": "workspace:*",
    "@commerce/notifications-whatsapp": "workspace:*",
    "@commerce/payments-cashfree": "workspace:*",
    "@commerce/payments-decentro": "workspace:*",
    "@commerce/payments-razorpay": "workspace:*",
    "@commerce/plugin-back-in-stock": "workspace:*",
    "@commerce/plugin-gst-invoices": "workspace:*",
    "@commerce/plugin-shopify-import": "workspace:*",
    "@commerce/plugins": "workspace:*",
    "@commerce/shipping-delhivery": "workspace:*",
    "@commerce/shipping-shiprocket": "workspace:*",
    "@commerce/storage-r2": "workspace:*",
    "drizzle-orm": "^0.45.2"
  }
}
