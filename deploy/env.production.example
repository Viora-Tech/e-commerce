# Production env file for deploy/docker-compose.prod.yml (Dokploy → Environment, or a plain
# `.env` next to this file if you run `docker compose` by hand). Copy to `.env`, fill in real
# values, never commit it. See apps/docs/content/developer-docs/operations/deployment.mdx for
# the full runbook and docs/security/data-protection.md for what each secret protects and how
# to rotate it. `packages/config/src/env.ts` is still the source of truth for what each app
# actually validates at boot.

# --- Release -------------------------------------------------------------------------------
# Which GHCR build to run (ghcr.io/viora-tech/<app>:<IMAGE_TAG>, built by
# .github/workflows/release.yml). Leave unset for `latest`; set to a full commit sha to pin or
# roll back, then redeploy.
# IMAGE_TAG=

# --- Domains (Traefik/Dokploy labels read these; never hardcode a domain in the compose file) --
ADMIN_DOMAIN=admin.waimers.in
STOREFRONT_DOMAIN=waimers.in
# Public URLs the apps use for links, Better Auth's baseURL and CORS-like checks. Match the
# domains above, with scheme.
ADMIN_URL=https://admin.waimers.in
STOREFRONT_URL=https://waimers.in
# Worker URL shown to merchants for payment/shipment webhooks (Settings pages). Only needed if
# the worker is exposed publicly (see worker's commented-out Traefik labels in the compose file).
NEXT_PUBLIC_WORKER_URL=https://worker.waimers.in
# Name of the Docker network Dokploy's own Traefik instance uses. Confirm with
# `docker network ls` on the server; override only if it isn't `dokploy-network`.
# DOKPLOY_NETWORK=dokploy-network

# --- Database (Postgres, one instance, two roles — see docs/security/data-protection.md) ----
# The container's superuser/owner role and its password. DATABASE_URL_OWNER connects as this
# user: migrations, backup, restore.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=commerce
# Password for the RLS-restricted `app` role that deploy/postgres/init.sh creates on first
# boot. Must match the password embedded in DATABASE_URL below.
APP_DB_PASSWORD=
# postgres://app:<APP_DB_PASSWORD>@postgres:5432/commerce — what the running apps use.
DATABASE_URL=
# postgres://postgres:<POSTGRES_PASSWORD>@postgres:5432/commerce — migrations/backup/restore.
DATABASE_URL_OWNER=

# --- Queue (Dragonfly, a Redis-protocol store — same as docker-compose.yml in dev) -----------
# Internal service name (the `dragonfly` service below), not a managed Redis. Leave the
# default unless you point BullMQ at something else entirely.
REDIS_URL=redis://dragonfly:6379

# --- Auth and secrets/encryption keys (generate with `openssl rand -hex 32`, keep offline) ----
# Better Auth signing secret, 32+ characters.
AUTH_SECRET=
# Encrypts stored gateway credentials and customer phone numbers, 16+ characters. Rotation:
# set SETTINGS_SECRET_PREVIOUS to the old value while running `bun scripts/rotate-secrets.ts
# --apply` and `bun scripts/backfill-phone-encryption.ts --apply`, then remove it — see
# docs/security/data-protection.md, "Key rotation runbook".
SETTINGS_SECRET=
# SETTINGS_SECRET_PREVIOUS=
# Encrypts nightly backup archives, 16+ characters, separate from SETTINGS_SECRET so one leak
# doesn't also open the other. Required — backups refuse to run unencrypted in production.
BACKUP_ENCRYPTION_KEY=
# Razorpay Technology Partner OAuth app (optional): both set shows a one-click "Connect
# Razorpay" button; unset, merchants paste API keys instead. Redirect URL to register on the
# Razorpay partner dashboard: <ADMIN_URL>/api/apps/razorpay/oauth/callback.
# RAZORPAY_OAUTH_CLIENT_ID=
# RAZORPAY_OAUTH_CLIENT_SECRET=

# --- Storage (product media — pick one; both unset falls back to the local disk provider, not
# recommended in this multi-container prod setup since containers don't share a disk) --------
# Cloudflare R2 (recommended, S3-compatible, already the platform's live provider).
# R2_PUBLIC_BASE_URL=
# Amazon S3, alternative to R2 (all five required if used; R2 wins if both are set). These are
# store Connection credentials configured in the admin UI, not read from env at boot — only
# the public base URL below needs to be set before the build that serves it (next/image
# allow-list).
# S3_PUBLIC_BASE_URL=

# --- Platform email (SES — required for order emails to actually send in production) --------
# `dev` (default) sends nothing; set `ses` once the SES_* keys below and PLATFORM_EMAIL_FROM
# are ready. See apps/docs/content/developer-docs/operations/email-sending.mdx.
SENDER_EMAIL_PROVIDER=ses
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# Optional SES configuration set every store identity uses for bounce/complaint events.
# SES_CONFIGURATION_SET=
PLATFORM_EMAIL_FROM=no-reply@mail.waimers.in
# PLATFORM_EMAIL_NAME=Waimers

# --- Domains (custom domain verification for merchant storefronts) ---------------------------
# `dev` (default) checks nothing on the network. Leave as `dev` until a real domain-checking
# provider is built (tracked in docs/handoff.md).
DOMAIN_PROVIDER=dev
# A record target for apex custom domains merchants point at this server's static IP.
# STOREFRONT_A_RECORD=
# CNAME target for subdomain custom domains.
# STOREFRONT_CNAME_TARGET=
# Comma-separated platform domains that can never be connected as a merchant's custom domain.
PLATFORM_DOMAINS=waimers.in,admin.waimers.in
# New stores get <slug>.<PLATFORM_STORE_DOMAIN> as their primary domain.
# PLATFORM_STORE_DOMAIN=waimers.store
# Who may sign up and create a store: invite (default) or open.
# MERCHANT_SIGNUP_MODE=invite
# The platform's own store that sells plans (a paid platform-plan order sends a signup invite).
# PLATFORM_SALES_STORE_ID=

# --- Client IP (per-IP rate limits) -----------------------------------------------------------
# cloudflare: believe cf-connecting-ip. ONLY safe when the Lightsail firewall accepts 80/443
# from Cloudflare's published IP ranges alone (https://www.cloudflare.com/ips/), otherwise
# anyone can send a fake header and get a fresh rate-limit bucket per request. none: ignore
# every forwarded header. See the deployment runbook, "Lock the origin to Cloudflare".
TRUSTED_PROXY=cloudflare

# --- Shopper sign-in (Google, Apple, Facebook, Truecaller) -------------------------------------
# The platform login domain every store's "Continue with ..." goes through (answered by the
# storefront). Default https://accounts.<PLATFORM_STORE_DOMAIN>. Provider redirect URIs are
# <ACCOUNTS_URL>/oauth/<google|apple|facebook>/callback; Truecaller's is
# <ACCOUNTS_URL>/truecaller/callback. Leave a provider unset to hide its button (merchants can
# still add their own apps).
# ACCOUNTS_URL=
# SHOPPER_GOOGLE_CLIENT_ID=
# SHOPPER_GOOGLE_CLIENT_SECRET=
# SHOPPER_APPLE_SERVICES_ID=
# SHOPPER_APPLE_TEAM_ID=
# SHOPPER_APPLE_KEY_ID=
# The .p8 key on one line with \n for line breaks.
# SHOPPER_APPLE_PRIVATE_KEY=
# SHOPPER_FACEBOOK_APP_ID=
# SHOPPER_FACEBOOK_APP_SECRET=
# SHOPPER_TRUECALLER_PARTNER_KEY=
# SHOPPER_TRUECALLER_PARTNER_NAME=

# --- Error tracking (optional) ----------------------------------------------------------------
# GlitchTip or Sentry DSN. Off everywhere unless set.
# SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Optional: defaults to IMAGE_TAG (the commit sha) when that is pinned; set by hand to override.
# SENTRY_RELEASE=

# --- Backups (nightly encrypted Postgres dump to R2/S3 — see the `backup` service and
# apps/docs/content/developer-docs/operations/backups.mdx) ------------------------------------
# Separate R2 bucket/token from the store-media one above, scoped to Object Read & Write only.
BACKUP_R2_ACCOUNT_ID=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
BACKUP_R2_BUCKET=
# UTC hour the nightly backup runs (default 03, i.e. ~08:30 IST). Only used by the
# docker-compose `backup` service — irrelevant if you use a Dokploy Scheduled Job instead.
# BACKUP_HOUR_UTC=03

# --- Couriers (Delhivery, Shiprocket, RapidShyp — store Connection credentials configured in
# the admin UI, not read from env at boot in production; these only matter for the live test
# suites in CI/dev, never set them here) --------------------------------------------------------

# --- Analytics --------------------------------------------------------------------------------
# No platform-level analytics keys today — per-store tracking (GA4, Meta Pixel, etc.) is
# configured in the admin UI, not env vars.
