# Production env file for deploy/docker-compose.prod.yml (Dokploy → Environment, or a plain
# `.env` next to this file if you run `docker compose` by hand). Copy to `.env`, fill in real
# values, never commit it. See apps/docs/content/developer-docs/operations/deployment.mdx for
# the full runbook and docs/security/data-protection.md for what each secret protects and how
# to rotate it. `packages/config/src/env.ts` is still the source of truth for what each app
# actually validates at boot.

# --- Release -------------------------------------------------------------------------------
# Which GHCR build to run (ghcr.io/viora-tech/<app>:<IMAGE_TAG>, built by
# .github/workflows/release.yml). Leave unset for `latest`; set to a full commit sha to pin or
# roll back, then redeploy.
# IMAGE_TAG=

# --- Domains (Traefik/Dokploy labels read these; never hardcode a domain in the compose file) --
ADMIN_DOMAIN=admin.koomerce.app
STOREFRONT_DOMAIN=shops.koomerce.app
# Public URLs the apps use for links, Better Auth's baseURL and CORS-like checks. Match the
# domains above, with scheme.
ADMIN_URL=https://admin.koomerce.app
# Fallback only: store links (View store, previews, emails) use each store's live primary
# domain, and this URL only for a store that has none yet.
STOREFRONT_URL=https://shops.koomerce.app
# Branded, theme-free checkout origin (security audit D-01 phase B). When set (e.g. `checkout`),
# each store checks out on `<this>.<its primary host>` (checkout.waimers.com) instead of /checkout
# on the store origin, so theme JavaScript can't reach the checkout page. Leave BLANK until every
# store's `checkout.*` host has DNS + a TLS cert provisioned; a blank keeps checkout same-origin
# (the safe default and the instant rollback). A single DNS label only.
# CHECKOUT_SUBDOMAIN=checkout
# Worker URL shown to merchants for payment/shipment webhooks (Settings pages). Only needed if
# the worker is exposed publicly (see worker's commented-out Traefik labels in the compose file).
NEXT_PUBLIC_WORKER_URL=https://api.koomerce.app
# Name of the Docker network Dokploy's own Traefik instance uses. Confirm with
# `docker network ls` on the server; override only if it isn't `dokploy-network`.
# DOKPLOY_NETWORK=dokploy-network

# --- Database (Postgres, one instance, two roles — see docs/security/data-protection.md) ----
# The container's superuser/owner role and its password. DATABASE_URL_OWNER connects as this
# user: migrations, backup, restore.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=commerce
# Password for the RLS-restricted `app` role that deploy/postgres/init.sh creates on first
# boot. Must match the password embedded in DATABASE_URL below.
APP_DB_PASSWORD=
# postgres://app:<APP_DB_PASSWORD>@postgres:5432/commerce — what the running apps use.
DATABASE_URL=
# postgres://postgres:<POSTGRES_PASSWORD>@postgres:5432/commerce — migrations/backup/restore.
DATABASE_URL_OWNER=
# Through PgBouncer (transaction mode): DATABASE_URL becomes
# postgres://app:<APP_DB_PASSWORD>@pgbouncer:6432/commerce, DATABASE_POOLED=true, and
# DATABASE_URL_DIRECT keeps postgres://app:<APP_DB_PASSWORD>@postgres:5432/commerce for the
# storefront cache's LISTEN connection. Migrations (DATABASE_URL_OWNER) always go direct.
# DATABASE_POOLED=
# DATABASE_URL_DIRECT=

# --- Queue (Dragonfly, a Redis-protocol store — same as docker-compose.yml in dev) -----------
# Internal service name (the `dragonfly` service below), not a managed Redis. Leave the
# default unless you point BullMQ at something else entirely.
REDIS_URL=redis://dragonfly:6379

# --- Auth and secrets/encryption keys (generate with `openssl rand -hex 32`, keep offline) ----
# Better Auth signing secret, 32+ characters.
AUTH_SECRET=
# Encrypts stored gateway credentials and customer phone numbers, 16+ characters. Rotation:
# set SETTINGS_SECRET_PREVIOUS to the old value while running `bun scripts/rotate-secrets.ts
# --apply` and `bun scripts/backfill-phone-encryption.ts --apply`, then remove it — see
# docs/security/data-protection.md, "Key rotation runbook".
SETTINGS_SECRET=
# SETTINGS_SECRET_PREVIOUS=
# Encrypts nightly backup archives, 16+ characters, separate from SETTINGS_SECRET so one leak
# doesn't also open the other. Required — backups refuse to run unencrypted in production.
BACKUP_ENCRYPTION_KEY=
# Razorpay Technology Partner OAuth app (optional): both set shows a one-click "Connect
# Razorpay" button; unset, merchants paste API keys instead. Redirect URL to register on the
# Razorpay partner dashboard: <ADMIN_URL>/api/apps/razorpay/oauth/callback.
# RAZORPAY_OAUTH_CLIENT_ID=
# RAZORPAY_OAUTH_CLIENT_SECRET=

# --- Storage (product media — pick one; both unset falls back to the local disk provider, not
# recommended in this multi-container prod setup since containers don't share a disk) --------
# Cloudflare R2 (recommended, S3-compatible, already the platform's live provider).
# R2_PUBLIC_BASE_URL=
# Amazon S3, alternative to R2 (all five required if used; R2 wins if both are set). These are
# store Connection credentials configured in the admin UI, not read from env at boot — only
# the public base URL below needs to be set before the build that serves it (next/image
# allow-list).
# S3_PUBLIC_BASE_URL=

# --- Platform email (SES or Resend — required for order emails to actually send in production)
# `dev` (default) sends nothing; set `ses` once the SES_* keys below and PLATFORM_EMAIL_FROM
# are ready, or `resend` with RESEND_API_KEY (PLATFORM_EMAIL_FROM's domain verified in Resend).
# Stores' own sender domains are always verified and sent through SES, so keep the SES_* keys
# even with `resend` if merchants should send from their own domain.
# See apps/docs/content/developer-docs/operations/email-sending.mdx.
SENDER_EMAIL_PROVIDER=ses
# The other provider, tried when the first is down, throttled or paused (needs its keys too).
# Blank or `none`: no fallback.
# SENDER_EMAIL_FALLBACK=resend
# Resend API key with sending access (https://resend.com/api-keys).
# RESEND_API_KEY=
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# Optional SES configuration set every store identity uses for bounce/complaint events.
# SES_CONFIGURATION_SET=
PLATFORM_EMAIL_FROM=no-reply@mail.koomerce.app
# PLATFORM_EMAIL_NAME=Koomerce

# --- Image processing (worker) --------------------------------------------------------------
# Images optimised at once, and the most from one store at once (default 3 and 3, for a 2-vCPU
# box; the store cap is never above the total). Raise both on a bigger box.
# MEDIA_PROCESS_CONCURRENCY=3
# MEDIA_PROCESS_PER_STORE=3

# --- Storefront cache ------------------------------------------------------------------------
# Render cache in MB (theme sections and store data; dropped the moment the merchant saves; 0 =
# off), and how long a CDN may keep a page for visitors without cookies, in seconds (0 = private).
# Keep the cache well under the storefront's memory limit.
# STOREFRONT_CACHE_MB=48
# STOREFRONT_EDGE_TTL=30
# Sections of an imported theme's page sent first; the rest stream in behind them (default 3).
# STOREFRONT_EAGER_SECTIONS=3

# --- Domains (custom domain verification for merchant storefronts) ---------------------------
# `dev` (default) checks nothing on the network, so real domains stay pending forever. `dns`
# looks up merchants' DNS records and checks the certificate; it needs STOREFRONT_A_RECORD set.
# Each live domain also needs an HTTPS route on the storefront app in Dokploy. With the four
# DOKPLOY_* keys below set (worker only), the worker adds it once DNS is verified and deletes it
# when the domain is removed; unset, add each domain by hand. Setup: developer docs, Custom domains.
DOMAIN_PROVIDER=dev
# This server's public IPv4: apex custom domains point their A record here.
# STOREFRONT_A_RECORD=
# CNAME target for subdomain custom domains.
# STOREFRONT_CNAME_TARGET=shops.koomerce.app
# Dokploy's base URL as the worker reaches it (no /api), e.g. https://dokploy.example.com.
# DOKPLOY_URL=
# Dokploy API key: Dokploy -> Settings -> Profile -> API/CLI -> Generate. Worker only; secret.
# DOKPLOY_API_KEY=
# The storefront application's id in Dokploy (from its URL: .../services/application/<id>).
# DOKPLOY_STOREFRONT_APPLICATION_ID=
# The port the storefront container listens on.
# DOKPLOY_STOREFRONT_PORT=3100
# The platform's OWN domains (comma-separated; subdomains are covered). No merchant can connect
# them as a custom domain or send email from them, and the platform sender falls back to
# no-reply@<first one> when PLATFORM_EMAIL_FROM is unset. Never list a merchant's domain here
# (e.g. waimers.in), or that store can't connect it. Needed by admin and worker.
PLATFORM_DOMAINS=koomerce.app,vioratech.in
# New stores get <slug>.<PLATFORM_STORE_DOMAIN> as their primary domain.
# PLATFORM_STORE_DOMAIN=koomerce.app
# Who may sign up and create a store: open (production default since 2026-10-28, anyone who
# signs in) or invite (only emails from `bun run platform:invite`).
# MERCHANT_SIGNUP_MODE=open
# Merchant "Continue with Google" on the admin login page (optional): a Google Cloud OAuth web
# client. Both set shows the button; either blank hides it. Authorised redirect URI to register:
# <ADMIN_URL>/api/auth/callback/google. Separate from the SHOPPER_GOOGLE_* storefront app.
# MERCHANT_GOOGLE_CLIENT_ID=
# MERCHANT_GOOGLE_CLIENT_SECRET=
# App-store reviewers (Shopify, Meta) can't receive a sign-in code: both set lets that one existing
# member sign in with a password (20+ characters). Never a real merchant's email; blank turns it off.
# REVIEWER_LOGIN_EMAIL=
# REVIEWER_LOGIN_PASSWORD=
# Google Search Console app (optional): an OAuth web client with the Search Console API enabled.
# Blank uses the MERCHANT_GOOGLE_* client above. Either way, register the redirect URI
# <ADMIN_URL>/api/apps/google-search-console/oauth/callback on the client you use.
# GSC_GOOGLE_CLIENT_ID=
# GSC_GOOGLE_CLIENT_SECRET=
# Sales channels → Google Merchant Center (optional): an OAuth web client with the Content API.
# Blank uses the MERCHANT_GOOGLE_* client. Redirect URI: <ADMIN_URL>/api/channels/google/callback.
# GMC_GOOGLE_CLIENT_ID=
# GMC_GOOGLE_CLIENT_SECRET=
# Sales channels → Facebook, Instagram, WhatsApp (optional): the platform's Meta app. Either blank
# keeps "Connect" as a request. Redirect URI: <ADMIN_URL>/api/channels/meta/callback.
# META_APP_ID=
# META_APP_SECRET=
# Meta Login for Business configuration ids (catalog, WhatsApp Embedded Signup) and the
# webhook verify token you type in the Meta app (callback <worker>/webhooks/platform/meta).
# META_LOGIN_CONFIG_ID=
# META_WHATSAPP_CONFIG_ID=
# META_WEBHOOK_VERIFY_TOKEN=
# The Koomerce migration app on Shopify (integrations/shopify/shopify.app.toml).
# SHOPIFY_APP_CLIENT_ID=
# SHOPIFY_APP_CLIENT_SECRET=
# The platform's own store that sells plans (a paid platform-plan order sends a signup invite).
# PLATFORM_SALES_STORE_ID=
# UPI AutoPay for plans (optional): the platform's own Razorpay account with Subscriptions on.
# All three set turns AutoPay on. Webhook: <ADMIN_URL>/api/billing/autopay-webhook (subscription.*).
# PLATFORM_RAZORPAY_KEY_ID=
# PLATFORM_RAZORPAY_KEY_SECRET=
# PLATFORM_RAZORPAY_WEBHOOK_SECRET=

# --- Client IP (per-IP rate limits) -----------------------------------------------------------
# cloudflare: believe cf-connecting-ip. ONLY safe when the Lightsail firewall accepts 80/443
# from Cloudflare's published IP ranges alone (https://www.cloudflare.com/ips/), otherwise
# anyone can send a fake header and get a fresh rate-limit bucket per request. none: ignore
# every forwarded header. See the deployment runbook, "Lock the origin to Cloudflare".
TRUSTED_PROXY=cloudflare

# --- Shopper sign-in (Google, Apple, Facebook, Truecaller) -------------------------------------
# The platform login domain every store's "Continue with ..." goes through (answered by the
# storefront). Default https://accounts.<PLATFORM_STORE_DOMAIN>. Provider redirect URIs are
# <ACCOUNTS_URL>/oauth/<google|apple|facebook>/callback; Truecaller's is
# <ACCOUNTS_URL>/truecaller/callback. Leave a provider unset to hide its button (merchants can
# still add their own apps).
# ACCOUNTS_URL=
# SHOPPER_GOOGLE_CLIENT_ID=
# SHOPPER_GOOGLE_CLIENT_SECRET=
# SHOPPER_APPLE_SERVICES_ID=
# SHOPPER_APPLE_TEAM_ID=
# SHOPPER_APPLE_KEY_ID=
# The .p8 key on one line with \n for line breaks.
# SHOPPER_APPLE_PRIVATE_KEY=
# SHOPPER_FACEBOOK_APP_ID=
# SHOPPER_FACEBOOK_APP_SECRET=
# SHOPPER_TRUECALLER_PARTNER_KEY=
# SHOPPER_TRUECALLER_PARTNER_NAME=

# --- AI features (optional) -------------------------------------------------------------------
# One platform key for every store (merchants never bring their own). Set it in Dokploy's
# Environment tab as a secret, never in the repo. Set ONE gateway key; with none, AI is off and
# the admin hides every AI button. Usage is metered per store per month (Settings > AI).
# AI_GATEWAY_API_KEY=
# OPENROUTER_API_KEY=
# gateway | openrouter | off. Unset picks the gateway whose key is set. (`mock` is refused here.)
# AI_PROVIDER=
# Swap the fast model (assistant chat, tools, quick writing; gateway model id). Unset: anthropic/claude-haiku-4.5.
# AI_MODEL=
# Swap the stronger model for long writing ("Best" writing quality in Settings > AI). Unset: anthropic/claude-sonnet-4.5.
# AI_MODEL_STRONG=
# Tool-calling rounds the assistant may take before it must answer (1-20). Unset: 6.
# AI_MAX_STEPS=
# Store slugs on the unlimited AI plan, comma-separated: the platform's own stores.
AI_UNLIMITED_STORES=waimers

# --- Error tracking (optional) ----------------------------------------------------------------
# GlitchTip or Sentry DSN. Off everywhere unless set.
# SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Optional: defaults to IMAGE_TAG (the commit sha) when that is pinned; set by hand to override.
# SENTRY_RELEASE=

# --- Structured logs (optional) ---------------------------------------------------------------
# One wide event per request, procedure call and job, as JSON on stdout. Set the endpoint to also
# ship them to OpenObserve (or any OTLP/HTTP logs backend). See docs/ops/logging.md.
# Full logs URL, e.g. https://<openobserve-host>/api/default/v1/logs
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
# Authorization=Basic%20<base64 of user:password> (OTel style: comma-separated, URL-encoded)
OTEL_EXPORTER_OTLP_HEADERS=
# Percent of ordinary successful requests and jobs kept (errors and slow ones always are). Default 20.
LOG_SAMPLE_RATE=

# --- "Report a bug" button (test server only) -------------------------------------------------
# On: every signed-in admin member gets a "Report a bug" button and each report becomes a GitHub
# issue. Leave off on the live server (screenshots can show store data). On in production needs
# GITHUB_ISSUES_TOKEN, or the apps refuse to start. See developer docs, Operations > Bug reports.
# BUG_REPORTS_ENABLED=false
# Fine-grained token: only the one repository, only "Issues: Read and write".
# GITHUB_ISSUES_TOKEN=
# Repository issues are filed in. Unset: Viora-Tech/e-commerce.
# GITHUB_ISSUES_REPO=
# Secret of the repository webhook <ADMIN_URL>/api/github/webhook (events: Issues, Issue comments,
# Pushes, Pull requests; content type application/json). It moves each report's status in
# Account -> My reports. Unset: the route answers 404 and the worker's 15-minute poll does it.
# Make one with: openssl rand -hex 32
# GITHUB_WEBHOOK_SECRET=
# Commit shown on each report. Unset: IMAGE_TAG, then SENTRY_RELEASE, then "unknown".
# SOURCE_COMMIT=

# --- Platform console (/platform) -------------------------------------------------------------
# Comma-separated emails of Koomerce staff allowed into the platform console. Each must also sign
# in with a passkey for the session. Blank: nobody, the console answers "not found".
PLATFORM_ADMIN_EMAILS=

# --- Backups (nightly encrypted Postgres dump to R2/S3 — see the `backup` service and
# apps/docs/content/developer-docs/operations/backups.mdx) ------------------------------------
# Separate R2 bucket/token from the store-media one above, scoped to Object Read & Write only.
BACKUP_R2_ACCOUNT_ID=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
BACKUP_R2_BUCKET=
# UTC hour the nightly backup runs (default 03, i.e. ~08:30 IST). Only used by the
# docker-compose `backup` service — irrelevant if you use a Dokploy Scheduled Job instead.
# BACKUP_HOUR_UTC=03

# --- Couriers (Delhivery, Shiprocket, RapidShyp, Xpressbees, Ekart, Shadowfax — store Connection credentials configured in
# the admin UI, not read from env at boot in production; these only matter for the live test
# suites in CI/dev, never set them here) --------------------------------------------------------

# --- Analytics --------------------------------------------------------------------------------
# No platform-level analytics keys today — per-store tracking (GA4, Meta Pixel, etc.) is
# configured in the admin UI, not env vars.
# Umami addresses the server may reach on a private network or over http (comma-separated
# origins, e.g. our own http://umami:3000). Any other address a store saves must be public https.
# UMAMI_TRUSTED_ORIGINS=
# Meilisearch addresses the server may reach on a private network or over http (comma-separated
# origins, e.g. our own http://meilisearch:7700). Any other address a store saves must be public https.
# MEILISEARCH_TRUSTED_ORIGINS=
# Chatwoot addresses the server may reach on a private network or over http (comma-separated
# origins, e.g. http://chatwoot:3000). Any other address a store saves must be public https.
# CHATWOOT_TRUSTED_ORIGINS=
# GrowthBook addresses the server may reach the same way (our own http://growthbook:3100).
# GROWTHBOOK_TRUSTED_ORIGINS=
