{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/drizzle",
      "!**/.turbo",
      "!**/coverage",
      "!**/.next",
      "!apps/www/out",
      "!apps/docs/out",
      "!**/.wrangler",
      "!**/worker-configuration.d.ts",
      "!apps/docs/public/_pagefind",
      "!apps/www/public",
      "!packages/blocks/src/styles",
      "!packages/ui/src/styles.css",
      "!apps/admin/src/app/globals.css",
      "!**/next-env.d.ts",
      "!packages/core/src/catalog/product-taxonomy.json",
      "!.claude"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["packages/blocks/src/components/**", "packages/blocks/src/puck-config.tsx"],
      "linter": {
        "rules": {
          "performance": {
            "noImgElement": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/ui/src/components/**"],
      "linter": {
        "rules": {
          "recommended": true,
          "suspicious": {
            "noArrayIndexKey": "off",
            "noExplicitAny": "off",
            "noDocumentCookie": "off",
            "noImplicitAnyLet": "off"
          },
          "correctness": {
            "useExhaustiveDependencies": "off"
          },
          "a11y": {
            "recommended": false
          },
          "style": {
            "recommended": false
          },
          "complexity": {
            "recommended": false
          },
          "performance": {
            "noImgElement": "off"
          },
          "security": {
            "noDangerouslySetInnerHtml": "off"
          }
        }
      }
    }
  ]
}
