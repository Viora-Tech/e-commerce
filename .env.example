# Copy to .env and fill in. packages/config/src/env.ts is the source of truth
# for the app keys. Uncommented keys are required; commented ones are optional
# or have a default, so uncomment them only to set a value (a blank value is
# not the same as unset and fails validation). Never commit real values.

# --- Database and queue (required) ---
# Postgres as the RLS-restricted `app` role, used by the apps at runtime.
DATABASE_URL=
# Postgres as the owner role: migrations, seeds and RLS setup.
DATABASE_URL_OWNER=
# Redis for BullMQ queues and visitor counters.
REDIS_URL=

# --- Apps ---
# Port the worker listens on (webhooks, jobs). Default 4100.
# WORKER_PORT=
# Better Auth signing secret, at least 32 characters. Required by the admin app.
AUTH_SECRET=
# Public admin URL, Better Auth's baseURL. Default http://localhost:3200.
# ADMIN_URL=
# Public storefront URL, used for links in notifications. Default http://localhost:3100.
# STOREFRONT_URL=
# Encrypts stored gateway credentials, 16+ characters. Dev default; set it in production.
# SETTINGS_SECRET=
# Retired SETTINGS_SECRET value(s), comma-separated. Set only while rotating (see
# docs/security/data-protection.md); remove once scripts/rotate-secrets.ts --apply finishes.
# SETTINGS_SECRET_PREVIOUS=
# Encrypts backup archives, 16+ characters, separate from SETTINGS_SECRET. Required in
# production; without it dev backups are written unencrypted (with a warning).
# BACKUP_ENCRYPTION_KEY=
# Razorpay Technology Partner OAuth app: both set shows "Connect Razorpay" (one click) on the
# Razorpay app; unset, merchants paste API keys. Register the redirect URL
# <ADMIN_URL>/api/apps/razorpay/oauth/callback on the Razorpay partner dashboard.
# RAZORPAY_OAUTH_CLIENT_ID=
# RAZORPAY_OAUTH_CLIENT_SECRET=
# Worker URL shown to merchants for payment webhooks. Default http://localhost:4100.
# NEXT_PUBLIC_WORKER_URL=
# Public base URL of the media bucket; lets next/image load uploaded images.
# R2_PUBLIC_BASE_URL=
# Amazon S3 storage connection, alternative to R2 above (R2 wins if both are fully set).
# All five required vars must be set for the store to seed with S3 enabled.
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=
# S3_BUCKET=
# Public base URL of the S3 bucket or its CloudFront domain; lets next/image load uploaded
# images. Leave unset to use the bucket's own virtual-hosted-style S3 URL.
# S3_PUBLIC_BASE_URL=
# Optional folder inside the bucket, e.g. waimers.
# S3_PATH_PREFIX=
# Folder the built-in local storage provider reads and writes, relative to the admin app
# (or another process's LOCAL_UPLOAD_ROOT). Default ./.data/uploads, gitignored.
# LOCAL_STORAGE_DIR=
# Custom domains. DOMAIN_PROVIDER=dev checks nothing on the network: *.test and
# *.example verify, fail.* is misconfigured, real domains stay pending.
# DOMAIN_PROVIDER=dev
# A record target for apex custom domains, and CNAME target for subdomains.
# STOREFRONT_A_RECORD=192.0.2.10
# STOREFRONT_CNAME_TARGET=shops.waimers.localhost
# Platform domains (comma-separated) that cannot be connected as custom. Default localhost.
# PLATFORM_DOMAINS=localhost

# --- Platform email (optional in development) ---
# One Amazon SES account sends every store's customer email; each store's sender domain
# (Settings → Notifications → Sender email) is a domain identity in it. `dev` (default) checks
# sender domains offline and sends nothing through the platform. `ses` needs the SES_* keys
# below and PLATFORM_EMAIL_FROM. See apps/docs/content/developer-docs/operations/email-sending.mdx.
# SENDER_EMAIL_PROVIDER=ses
# The platform's own verified sender, used until a store's address is verified.
# PLATFORM_EMAIL_FROM=no-reply@mail.waimers.com
# Display name when a store has no name. Default Waimers.
# PLATFORM_EMAIL_NAME=
# Optional SES configuration set every store identity uses (bounce/complaint events).
# SES_CONFIGURATION_SET=
# (SES_REGION, SES_ACCESS_KEY_ID and SES_SECRET_ACCESS_KEY are under "Live provider tests".)

# --- Error tracking (optional) ---
# A GlitchTip (or Sentry) DSN. Error tracking is off everywhere unless this is set; see
# docs/ops/error-tracking.md, including how to run GlitchTip locally with `docker compose
# --profile observability up`.
# SENTRY_DSN=
# Environment tag on every event. Defaults from NODE_ENV when unset.
# SENTRY_ENVIRONMENT=
# Release tag on every event, e.g. a git SHA set by the deploy pipeline.
# SENTRY_RELEASE=

# --- Backups (optional, only needed to run scripts/backup-db.ts) ---
# Cloudflare R2 credentials the backup script uploads to. See docs/ops/backups.md.
# BACKUP_R2_ACCOUNT_ID=
# BACKUP_R2_ACCESS_KEY_ID=
# BACKUP_R2_SECRET_ACCESS_KEY=
# BACKUP_R2_BUCKET=
# Write backups to a local folder instead of R2 (dev, or a single-server store). Takes
# priority over BACKUP_R2_* when set.
# BACKUP_LOCAL_DIR=

# Who may sign up and create their own store: invite (default) or open.
# MERCHANT_SIGNUP_MODE=invite
# New stores get <slug>.<this> as their primary domain.
# PLATFORM_STORE_DOMAIN=waimers.store

# --- Shopper sign-in (Google, Apple, Facebook, Truecaller) ---
# The one platform login domain every store's "Continue with ..." goes through, answered by
# the storefront app. Default https://accounts.<PLATFORM_STORE_DOMAIN>. On localhost use a host
# that is not a store, e.g. http://127.0.0.1:3100. Provider redirect URIs are
# <ACCOUNTS_URL>/oauth/<google|apple|facebook>/callback; Truecaller's callback is
# <ACCOUNTS_URL>/truecaller/callback. Unset keys: merchants can still add their own apps.
# ACCOUNTS_URL=
# SHOPPER_GOOGLE_CLIENT_ID=
# SHOPPER_GOOGLE_CLIENT_SECRET=
# SHOPPER_APPLE_SERVICES_ID=
# SHOPPER_APPLE_TEAM_ID=
# SHOPPER_APPLE_KEY_ID=
# The .p8 key on one line with \n for line breaks.
# SHOPPER_APPLE_PRIVATE_KEY=
# SHOPPER_FACEBOOK_APP_ID=
# SHOPPER_FACEBOOK_APP_SECRET=
# SHOPPER_TRUECALLER_PARTNER_KEY=
# SHOPPER_TRUECALLER_PARTNER_NAME=

# --- Development only ---
# Email that becomes owner of the seeded Waimers store (bun run db:seed).
# SEED_OWNER_EMAIL=
# Set to 1 to expose login codes at /api/dev/otp outside production.
# DEV_LOGIN_OTP=
# Test runs only: isolates this checkout's test databases (letters, digits, _).
# TEST_DB_NAMESPACE=

# --- Live provider tests (optional) ---
# Uncomment a group to run that provider's live suite; left commented, the
# offline tests use their built-in fakes. Blank-but-set values would not.
# Razorpay test-mode API key pair.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# Delhivery staging token and pickup details.
# DELHIVERY_API_TOKEN=
# DELHIVERY_BASE_URL=
# DELHIVERY_CLIENT_NAME=
# DELHIVERY_PICKUP=
# DELHIVERY_ORIGIN_PIN=
# Amazon SES credentials, verified sender and a recipient for the send test. The same
# SES_REGION / SES_ACCESS_KEY_ID / SES_SECRET_ACCESS_KEY are the platform email account when
# SENDER_EMAIL_PROVIDER=ses.
# SES_REGION=
# SES_ACCESS_KEY_ID=
# SES_SECRET_ACCESS_KEY=
# SES_FROM_EMAIL=
# SES_TEST_TO=
# WhatsApp Cloud API number, token and a recipient for the send test.
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_TEST_TO=
