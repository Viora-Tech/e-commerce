      "text": "definePlugin({\n  id, name, version,\n  kind: builtin | connection,\n  category, access (what it reads),\n  provides: payments, shipping,\n    notifications, storage,\n  hooks: { order.paid, … },\n  jobs, admin.pages,\n  productFields, orderLinks,\n  storefront.blocks, automations\n})",
