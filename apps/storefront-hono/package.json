{
  "name": "@commerce/storefront-hono",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pilot (roadmap speed track step 6, option B): the product page served by Bun + Hono from the storefront's own loaders and Liquid engine.",
  "scripts": {
    "start": "bun run --env-file=../../.env src/server.ts",
    "match": "bun scripts/html-match.ts",
    "typecheck": "bun ../../scripts/typecheck.ts"
  },
  "dependencies": {
    "@commerce/blocks": "workspace:*",
    "@commerce/config": "workspace:*",
    "@commerce/core": "workspace:*",
    "@commerce/db": "workspace:*",
    "@commerce/richtext": "workspace:*",
    "@commerce/storefront": "workspace:*",
    "@puckeditor/core": "^0.23.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "typescript": "~5.9.3"
  }
}
