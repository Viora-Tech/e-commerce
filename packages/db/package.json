{
  "name": "@commerce/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./test": "./test/reset.ts",
    "./migrate": "./src/migrate.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "bun run --env-file=../../.env src/migrate.ts",
    "seed": "bun run --env-file=../../.env src/seed.ts",
    "seed:demo": "bun run --env-file=../../.env src/seed-demo-orders.ts && bun run --env-file=../../.env src/seed-demo-drafts.ts && bun run --env-file=../../.env src/seed-demo-collections.ts",
    "seed:demo:collections": "bun run --env-file=../../.env src/seed-demo-collections.ts",
    "seed:navigation": "bun run --env-file=../../.env src/seed-navigation.ts",
    "seed:shipping": "bun run --env-file=../../.env src/seed-shipping-rates.ts",
    "seed:back-in-stock": "bun run --env-file=../../.env src/seed-back-in-stock.ts",
    "seed:demo:drafts": "bun run --env-file=../../.env src/seed-demo-drafts.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@commerce/config": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "4.1.11",
    "dotenv": "^18.0.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
