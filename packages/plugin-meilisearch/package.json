{
  "name": "@commerce/plugin-meilisearch",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Meilisearch search: typo-tolerant storefront search, ranked by a Meilisearch server the store connects, with the built-in search as the fallback.",
  "exports": {
    ".": "./src/plugin.ts",
    "./settings": "./src/settings.ts",
    "./client": "./src/client.ts",
