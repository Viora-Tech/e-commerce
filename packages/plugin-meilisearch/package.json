    "./server": "./src/server.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "bun ../../scripts/typecheck.ts"
  },
  "dependencies": {
    "@commerce/core": "workspace:*",
    "@commerce/db": "workspace:*",
    "@commerce/plugins": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commerce/config": "workspace:*",
    "@types/node": "^22.20.4",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
